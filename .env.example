# Copy this file to .env.local for local overrides, or to .env if you prefer Docker Compose defaults.
# Priority in scripts: process env > .env.local > .env > built-in defaults.

# Worker config
SANDBOX_CONFIG_FILE=configs/local.yaml
SANDBOX_ENV=local
SANDBOX_WORKER_ID=sandbox-worker-local-1

SANDBOX_KAFKA_BROKERS=localhost:29092
SANDBOX_KAFKA_CLIENT_ID=sandbox-worker-local
SANDBOX_KAFKA_GROUP_ID=sandbox-code-execution-v1
SANDBOX_KAFKA_TOPIC_REQUESTS=code-execution.requests.v1
SANDBOX_KAFKA_TOPIC_RETRY=code-execution.retry.v1
SANDBOX_KAFKA_TOPIC_EVENTS=code-execution.events.v1
SANDBOX_KAFKA_TOPIC_RESULTS=code-execution.results.v1
SANDBOX_KAFKA_TOPIC_DEADLETTER=code-execution.deadletter.v1
SANDBOX_KAFKA_RETRY_ENABLED=true
SANDBOX_KAFKA_RETRY_MAX_ATTEMPTS=3
SANDBOX_KAFKA_RETRY_INITIAL_BACKOFF_MS=500
SANDBOX_KAFKA_RETRY_MAX_BACKOFF_MS=30000
SANDBOX_KAFKA_RETRY_BACKOFF_MULTIPLIER=2
SANDBOX_KAFKA_RETRY_EARLY_SLEEP_CAP_MS=5000

SANDBOX_EXECUTOR_TYPE=fake
SANDBOX_GOJUDGE_BASE_URL=http://localhost:5050
SANDBOX_GOJUDGE_TLS_CA_FILE=
SANDBOX_GOJUDGE_TLS_CERT_FILE=
SANDBOX_GOJUDGE_TLS_KEY_FILE=
SANDBOX_EXECUTOR_CLIENT_TIMEOUT_MS=10000

SANDBOX_FEATURE_FAKE_EXECUTOR=true
SANDBOX_FEATURE_GOJUDGE_EXECUTOR=false
SANDBOX_FEATURE_INLINE_TESTS=true
SANDBOX_FEATURE_OBJECT_STORAGE_TESTS=false
SANDBOX_FEATURE_OBJECT_STORAGE_ARTIFACTS=true

SANDBOX_MAX_IN_FLIGHT=4
SANDBOX_PYTHON_MAX_IN_FLIGHT=4
SANDBOX_SCHEDULER_JOB_TIMEOUT_MS=10000
SANDBOX_SCHEDULER_QUEUE_MAX_DEPTH=16

SANDBOX_TESTS_PROVIDER=disabled
SANDBOX_TESTS_BUCKET=sandbox-tests
SANDBOX_TESTS_ENDPOINT=
SANDBOX_TESTS_REGION=
SANDBOX_TESTS_ACCESS_KEY_ID=
SANDBOX_TESTS_SECRET_ACCESS_KEY=
SANDBOX_TESTS_KEY_PREFIX=sandbox-tests
SANDBOX_TESTS_CACHE_TTL_MS=0
SANDBOX_TESTS_OBJECT_MAX_BYTES=1048576
SANDBOX_TESTS_REQUEST_TIMEOUT_MS=10000
SANDBOX_TESTS_FORCE_PATH_STYLE=true

SANDBOX_STORAGE_TYPE=memory
SANDBOX_POSTGRES_DSN=
SANDBOX_ARTIFACTS_ENABLED=true
SANDBOX_ARTIFACTS_PROVIDER=filesystem
SANDBOX_ARTIFACTS_BUCKET=sandbox-artifacts
SANDBOX_ARTIFACTS_ENDPOINT=
SANDBOX_ARTIFACTS_REGION=
SANDBOX_ARTIFACTS_ACCESS_KEY_ID=
SANDBOX_ARTIFACTS_SECRET_ACCESS_KEY=
SANDBOX_ARTIFACTS_ROOT_DIR=.sandbox-artifacts
SANDBOX_ARTIFACTS_KEY_PREFIX=sandbox-artifacts
SANDBOX_ARTIFACTS_INLINE_MAX_BYTES=4096
SANDBOX_ARTIFACTS_MAX_BYTES=1048576
SANDBOX_ARTIFACTS_REQUEST_TIMEOUT_MS=10000
SANDBOX_ARTIFACTS_FORCE_PATH_STYLE=true
SANDBOX_RETENTION_COMPLETED_RUNS_DAYS=7
SANDBOX_RETENTION_ARTIFACTS_DAYS=7
SANDBOX_RETENTION_PUBLISHED_OUTBOX_DAYS=3
SANDBOX_RETENTION_FAILED_OUTBOX_DAYS=30
SANDBOX_RETENTION_IDEMPOTENCY_KEYS_DAYS=30
SANDBOX_WORKER_HEARTBEAT_STALE_MS=120000

SANDBOX_ALLOW_USER_CODE_NETWORK=false
SANDBOX_DENY_METADATA_ENDPOINTS=true
SANDBOX_REDACT_SECRETS=true

SANDBOX_LOG_LEVEL=debug
SANDBOX_LOG_FORMAT=console
SANDBOX_METRICS_ENABLED=true
SANDBOX_TRACING_ENABLED=false
SANDBOX_AUDIT_ENABLED=true

# Docker Compose local stack
SANDBOX_GO_VERSION=1.26

SANDBOX_KAFKA_IMAGE=apache/kafka:3.9.1
SANDBOX_KAFKA_HOST_PORT=29092
SANDBOX_KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
SANDBOX_KAFKA_REQUEST_PARTITIONS=6
SANDBOX_KAFKA_RETRY_PARTITIONS=6
SANDBOX_KAFKA_RESULT_PARTITIONS=6
SANDBOX_KAFKA_EVENT_PARTITIONS=6
SANDBOX_KAFKA_DLQ_PARTITIONS=3

SANDBOX_GOJUDGE_IMAGE=criyle/go-judge:latest
SANDBOX_GOJUDGE_LOCAL_IMAGE=overmindv/sandbox-gojudge:local
SANDBOX_GOJUDGE_HOST_PORT=5050

SANDBOX_WORKER_IMAGE=overmindv/sandbox-worker:local
SANDBOX_WORKER_HEALTH_PORT=8080
SANDBOX_WORKER_METRICS_PORT=9090

SANDBOX_REDPANDA_CONSOLE_IMAGE=docker.redpanda.com/redpandadata/console:latest
SANDBOX_REDPANDA_CONSOLE_PORT=8088

SANDBOX_PROMETHEUS_IMAGE=prom/prometheus:latest
SANDBOX_PROMETHEUS_PORT=9091

SANDBOX_MINIO_IMAGE=minio/minio:latest
SANDBOX_MINIO_CLIENT_IMAGE=minio/mc:latest
SANDBOX_MINIO_ROOT_USER=minioadmin
SANDBOX_MINIO_ROOT_PASSWORD=minioadmin
SANDBOX_MINIO_API_PORT=9000
SANDBOX_MINIO_CONSOLE_PORT=9001
