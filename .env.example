SANDBOX_CONFIG_FILE=configs/local.yaml
SANDBOX_ENV=local
SANDBOX_WORKER_ID=sandbox-worker-local-1

SANDBOX_KAFKA_BROKERS=localhost:29092
SANDBOX_KAFKA_CLIENT_ID=sandbox-worker-local
SANDBOX_KAFKA_GROUP_ID=sandbox-code-execution-v1
SANDBOX_KAFKA_TOPIC_REQUESTS=code-execution.requests.v1
SANDBOX_KAFKA_TOPIC_EVENTS=code-execution.events.v1
SANDBOX_KAFKA_TOPIC_RESULTS=code-execution.results.v1
SANDBOX_KAFKA_TOPIC_DEADLETTER=code-execution.deadletter.v1

SANDBOX_EXECUTOR_TYPE=fake
SANDBOX_GOJUDGE_BASE_URL=http://localhost:5050
SANDBOX_EXECUTOR_CLIENT_TIMEOUT_MS=10000

SANDBOX_FEATURE_FAKE_EXECUTOR=true
SANDBOX_FEATURE_GOJUDGE_EXECUTOR=false
SANDBOX_FEATURE_INLINE_TESTS=true
SANDBOX_FEATURE_OBJECT_STORAGE_TESTS=false

SANDBOX_MAX_IN_FLIGHT=4
SANDBOX_PYTHON_MAX_IN_FLIGHT=4
SANDBOX_SCHEDULER_JOB_TIMEOUT_MS=10000
SANDBOX_SCHEDULER_QUEUE_MAX_DEPTH=16

SANDBOX_TESTS_PROVIDER=disabled
SANDBOX_TESTS_BUCKET=
SANDBOX_TESTS_ENDPOINT=
SANDBOX_TESTS_REGION=
SANDBOX_TESTS_ACCESS_KEY_ID=
SANDBOX_TESTS_SECRET_ACCESS_KEY=

SANDBOX_STORAGE_TYPE=memory
SANDBOX_POSTGRES_DSN=

SANDBOX_ALLOW_USER_CODE_NETWORK=false
SANDBOX_DENY_METADATA_ENDPOINTS=true
SANDBOX_REDACT_SECRETS=true

SANDBOX_LOG_LEVEL=debug
SANDBOX_LOG_FORMAT=console
SANDBOX_METRICS_ENABLED=true
SANDBOX_TRACING_ENABLED=false
SANDBOX_AUDIT_ENABLED=true
