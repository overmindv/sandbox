ARG GO_VERSION=1.26

FROM golang:${GO_VERSION}-alpine AS build

WORKDIR /src

RUN apk add --no-cache ca-certificates

ARG GO_BUILD_PARALLEL=2
ENV GOFLAGS=-p=${GO_BUILD_PARALLEL}

COPY go.mod go.sum ./
RUN --mount=type=cache,id=overmindv-gomod,target=/go/pkg/mod go mod download

COPY cmd ./cmd
COPY internal ./internal
COPY configs ./configs

ARG TARGETOS=linux
ARG TARGETARCH=amd64
RUN --mount=type=cache,id=overmindv-gomod,target=/go/pkg/mod \
    --mount=type=cache,id=overmindv-gobuild,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build -trimpath -ldflags="-s -w" -o /out/sandbox-worker ./cmd/sandbox-worker

FROM alpine:3.22

RUN apk add --no-cache ca-certificates tzdata \
	&& addgroup -S -g 10001 sandbox \
	&& adduser -S -D -H -u 10001 -G sandbox sandbox \
	&& mkdir -p /var/lib/sandbox/artifacts \
	&& chown -R sandbox:sandbox /var/lib/sandbox

WORKDIR /app

COPY --from=build /out/sandbox-worker /usr/local/bin/sandbox-worker
COPY configs ./configs

USER 10001:10001

EXPOSE 8080 9090

ENTRYPOINT ["/usr/local/bin/sandbox-worker"]
