FROM docker.io/criyle/go-judge:v1.14.1@sha256:da459bed95efca8f322d98598fed5822379b12bf2a0f83c17b34ad55bca19b30 AS judge
FROM docker.io/library/golang:1.26.11-alpine@sha256:ecb67f987aa1a57794c91d19ade7ae0209f2f0f5496aaef9e6ae85ddf92d02ab AS go-runtime

FROM go-runtime AS go-test-tools

WORKDIR /src
COPY go.mod ./
COPY cmd/sandbox-go-test-compile/ ./cmd/sandbox-go-test-compile/
COPY cmd/sandbox-go-test-run/ ./cmd/sandbox-go-test-run/
COPY internal/gotestjob/ ./internal/gotestjob/
ENV CGO_ENABLED=0 GOTOOLCHAIN=local GOENV=off
RUN --network=none go build -trimpath -ldflags='-s -w' -o /out/sandbox-go-test-compile ./cmd/sandbox-go-test-compile && \
	go build -trimpath -ldflags='-s -w' -o /out/sandbox-go-test-run ./cmd/sandbox-go-test-run && \
	go build -trimpath -ldflags='-s -w' -o /out/sandbox-go-test2json cmd/test2json

FROM go-runtime AS judge-build
WORKDIR /src
COPY runtimes/gojudge/go.mod runtimes/gojudge/go.sum ./
RUN --mount=type=cache,id=overmindv-gomod,target=/go/pkg/mod \
	--mount=type=cache,id=overmindv-gojudge-build,target=/root/.cache/go-build \
	CGO_ENABLED=0 GOTOOLCHAIN=local go build -mod=readonly -trimpath -ldflags="-s -w" -o /out/go-judge github.com/criyle/go-judge/cmd/go-judge

FROM go-runtime AS java-tools
WORKDIR /src
COPY go.mod ./
COPY cmd/sandbox-java-compile/ ./cmd/sandbox-java-compile/
COPY internal/javaclass/ ./internal/javaclass/
RUN --network=none CGO_ENABLED=0 GOTOOLCHAIN=local GOENV=off \
	go build -trimpath -ldflags="-s -w" -o /out/sandbox-java-compile ./cmd/sandbox-java-compile

FROM docker.io/library/python:3.12.16-slim-trixie@sha256:5e2bdb1b0d542d5039cffb8181c65930093949194a65c365dfb1b0fe13a4fa5b AS runtime

USER root

WORKDIR /opt
COPY --from=judge /opt/mount.yaml /opt/
COPY --from=judge-build /out/go-judge /opt/go-judge
COPY --from=go-runtime /usr/local/go /usr/local/go
COPY --from=go-test-tools /out/ /usr/local/bin/
COPY runtimes/python/requirements.txt /opt/pytest-requirements.txt

RUN set -eux; \
	apt-get update; \
	apt-get install -y --no-install-recommends curl; \
	rm -rf /var/lib/apt/lists/*; \
	python3 -m pip --disable-pip-version-check install --no-cache-dir --only-binary=:all: --require-hashes -r /opt/pytest-requirements.txt; \
	python3 -m pip --disable-pip-version-check check; \
	python3 -m compileall -q -j 2 -x '/(test|tests|__pycache__)/' /usr/local/lib/python3.12; \
	test "$(python3 --version)" = "Python 3.12.16"; \
	test "$(GOTOOLCHAIN=local /usr/local/go/bin/go env GOVERSION)" = "go1.26.11"

ENV PATH="/usr/local/go/bin:${PATH}" \
	CGO_ENABLED=0 \
	GOCACHE=/tmp/go-build \
	GOMODCACHE=/tmp/go-mod \
	GOTOOLCHAIN=local \
	GOPROXY=off

ENTRYPOINT ["/opt/go-judge"]
CMD []

FROM runtime AS cpp-compiler
RUN set -eux; \
	apt-get update; \
	apt-get install -y --no-install-recommends g++-14=14.2.0-19 libc6-dev; \
	rm -rf /var/lib/apt/lists/*; \
	test "$(/usr/bin/g++-14 -dumpfullversion)" = "14.2.0"

FROM runtime AS java-runner
ARG OPENJDK_PACKAGE_VERSION=21.0.13.1+2-1~deb13u1
RUN set -eux; \
	apt-get update; \
	apt-get install -y --no-install-recommends "openjdk-21-jre-headless=${OPENJDK_PACKAGE_VERSION}"; \
	rm -rf /var/lib/apt/lists/*; \
	test "$(dpkg-query -W -f='${Version}' openjdk-21-jre-headless)" = "${OPENJDK_PACKAGE_VERSION}"; \
	test ! -e /usr/bin/javac

FROM java-runner AS java-compiler
RUN set -eux; \
	apt-get update; \
	apt-get install -y --no-install-recommends "openjdk-21-jdk-headless=${OPENJDK_PACKAGE_VERSION}"; \
	rm -rf /var/lib/apt/lists/*; \
	test "$(dpkg-query -W -f='${Version}' openjdk-21-jdk-headless)" = "${OPENJDK_PACKAGE_VERSION}"
COPY --from=java-tools /out/sandbox-java-compile /usr/local/bin/

FROM go-runtime AS kotlin-tools
WORKDIR /src
COPY go.mod ./
COPY cmd/sandbox-kotlin-compile/ ./cmd/sandbox-kotlin-compile/
COPY internal/javaclass/ ./internal/javaclass/
RUN --network=none CGO_ENABLED=0 GOTOOLCHAIN=local GOENV=off \
	go build -trimpath -ldflags="-s -w" -o /out/sandbox-kotlin-compile ./cmd/sandbox-kotlin-compile

FROM runtime AS kotlin-dist
ADD --checksum=sha256:7cc140e76daf416a0424a5557f99afd7ca89ebd463ea1101261e3e01c33e75cd \
	https://github.com/JetBrains/kotlin/releases/download/v2.4.21/kotlin-compiler-2.4.21.zip /tmp/kotlin.zip
RUN --network=none python3 -m zipfile -e /tmp/kotlin.zip /opt/kotlin-dist

FROM java-runner AS kotlin-runner
COPY --from=kotlin-dist /opt/kotlin-dist/kotlinc/lib/kotlin-stdlib.jar /usr/local/share/sandbox/kotlin-stdlib.jar

FROM java-compiler AS kotlin-compiler
COPY --from=kotlin-dist \
	/opt/kotlin-dist/kotlinc/lib/kotlin-compiler.jar \
	/opt/kotlin-dist/kotlinc/lib/annotations-13.0.jar \
	/opt/kotlin-dist/kotlinc/lib/kotlin-stdlib.jar \
	/opt/kotlin-dist/kotlinc/lib/kotlin-reflect.jar \
	/opt/kotlin-dist/kotlinc/lib/kotlin-script-runtime.jar \
	/opt/kotlin-dist/kotlinc/lib/kotlinx-coroutines-core-jvm.jar \
	/usr/local/share/sandbox/
COPY --from=kotlin-tools /out/sandbox-kotlin-compile /usr/local/bin/

FROM go-runtime AS typescript-tools
WORKDIR /src
COPY go.mod ./
COPY cmd/sandbox-ts-compile/ ./cmd/sandbox-ts-compile/
COPY cmd/sandbox-ts-run/ ./cmd/sandbox-ts-run/
COPY internal/tsjob/ ./internal/tsjob/
ENV CGO_ENABLED=0 GOTOOLCHAIN=local GOENV=off
RUN --network=none go build -trimpath -ldflags="-s -w" -o /out/sandbox-ts-compile ./cmd/sandbox-ts-compile && \
	go build -trimpath -ldflags="-s -w" -o /out/sandbox-ts-run ./cmd/sandbox-ts-run

FROM docker.io/library/node:24.22.3-bookworm@sha256:9d266751ca3d7fdbe651c878ffd5ad0a42fed49a18c283509267c97f025b7496 AS typescript-node

FROM runtime AS typescript-runner
COPY --from=typescript-node /usr/local/bin/node /usr/local/bin/node
COPY --from=typescript-tools /out/sandbox-ts-run /usr/local/bin/
RUN --network=none test "$(/usr/local/bin/node --version)" = "v24.22.3"

FROM runtime AS typescript-dist
ARG TARGETARCH
RUN set -eux; \
	unpack_package() { \
		curl -fsSL --proto '=https' --retry 3 --max-time 180 "$1" -o /tmp/sandbox-ts.tgz; \
		printf '%s  /tmp/sandbox-ts.tgz\n' "$2" | sha512sum -c -; \
		mkdir -p "$3"; \
		tar -xzf /tmp/sandbox-ts.tgz --strip-components=1 -C "$3"; \
		rm -f /tmp/sandbox-ts.tgz; \
	}; \
	case "$TARGETARCH" in \
		amd64) unpack_package 'https://registry.npmjs.org/@typescript/typescript-linux-x64/-/typescript-linux-x64-7.0.2.tgz' \
			'11875fd9c360eeb8025899f109d27e177577f4ef2285bdfb78702ed4b2bca00162ce04d06cf38aef31c75db3edf2b5f6e023aa3835de237b087f47c25c6ec7fc' /opt/typescript/compiler ;; \
		arm64) unpack_package 'https://registry.npmjs.org/@typescript/typescript-linux-arm64/-/typescript-linux-arm64-7.0.2.tgz' \
			'421e1e538ff2df20e39df8e3c8f62284c8f9fce0c8966b7e073bb5ece23e7e24910d6e7b4265394a237addec4f44d24f294cdc73520d6b535776b27e32a1e351' /opt/typescript/compiler ;; \
		*) exit 1 ;; \
	esac; \
	unpack_package 'https://registry.npmjs.org/@types/node/-/node-24.19.2.tgz' \
		'f77778f700962640b237ceccc4ba4d37a2973c2c05c3b6d5520efd986515d4e4b8d09196c150abf27eb50d7092ab3ec257afd57cf91bef179ceee3f633e40759' /opt/typescript/node_modules/@types/node; \
	unpack_package 'https://registry.npmjs.org/undici-types/-/undici-types-7.24.6.tgz' \
		'591356fac2608f9381378ff42691c5aadab38696e75741ae07e3a8cc0f6008bedaf7ddd2994fb5241642ccb37162c6cc7c87832fe953b29843e6337937e9f4ce' /opt/typescript/node_modules/undici-types

FROM runtime AS typescript-compiler
COPY --from=typescript-dist /opt/typescript/ /usr/local/share/sandbox-ts/
COPY --from=typescript-tools /out/sandbox-ts-compile /usr/local/bin/
RUN --network=none test "$(/usr/local/share/sandbox-ts/compiler/lib/tsc --version)" = "Version 7.0.2"

FROM mcr.microsoft.com/dotnet/sdk:10.0.404-noble@sha256:2b1e13a22e46b55117f9cdb4b38e73172de08a30370166c8227d06cdaff82473 AS csharp-sdk
FROM mcr.microsoft.com/dotnet/runtime:10.0.15-noble@sha256:21bf94ddcec8efebe4ffa64a6bfd30fc270ee87f54277aa08210e4a1d5a0c560 AS csharp-framework

FROM go-runtime AS csharp-tools
WORKDIR /src
COPY go.mod ./
COPY cmd/sandbox-csharp-compile/ ./cmd/sandbox-csharp-compile/
COPY internal/dotnetjob/ ./internal/dotnetjob/
RUN --network=none CGO_ENABLED=0 GOTOOLCHAIN=local GOENV=off \
	go build -trimpath -ldflags="-s -w" -o /out/sandbox-csharp-compile ./cmd/sandbox-csharp-compile

FROM runtime AS csharp-runner
RUN set -eux; \
	apt-get update; \
	apt-get install -y --no-install-recommends libgssapi-krb5-2 libicu76 libssl3t64 libstdc++6 zlib1g; \
	rm -rf /var/lib/apt/lists/*
COPY --from=csharp-framework /usr/share/dotnet/ /usr/local/share/dotnet/
COPY runtimes/csharp/runtimeconfig.json /usr/local/share/sandbox-csharp/runtimeconfig.json
RUN --network=none test ! -d /usr/local/share/dotnet/sdk && \
	/usr/local/share/dotnet/dotnet --list-runtimes | grep -F 'Microsoft.NETCore.App 10.0.15 '

FROM csharp-runner AS csharp-compiler
COPY --from=csharp-sdk /usr/share/dotnet/sdk/10.0.404/Roslyn/bincore/ /usr/local/share/dotnet/sdk/10.0.404/Roslyn/bincore/
COPY --from=csharp-sdk /usr/share/dotnet/packs/Microsoft.NETCore.App.Ref/10.0.15/ref/net10.0/ /usr/local/share/dotnet/packs/Microsoft.NETCore.App.Ref/10.0.15/ref/net10.0/
COPY --from=csharp-tools /out/sandbox-csharp-compile /usr/local/bin/
RUN --network=none /usr/local/share/dotnet/dotnet exec /usr/local/share/dotnet/sdk/10.0.404/Roslyn/bincore/csc.dll -version

FROM docker.io/library/swift:6.4.3-noble@sha256:4ed5e0210b244aab174450e0b79014c17db60c63c6daf0709347fe50c767293a AS swift-sdk
FROM docker.io/library/swift:6.4.3-noble-slim@sha256:2bae57bd68ac95daa2d4aa2c7c590d4cf366c6007b4e5bc355e6cbe4dad16dcb AS swift-framework

FROM runtime AS swift-runner
RUN set -eux; \
	apt-get update; \
	apt-get install -y --no-install-recommends libatomic1 libstdc++6 libxml2; \
	rm -rf /var/lib/apt/lists/*
COPY --from=swift-framework /usr/lib/swift/linux/*.so /usr/lib/swift/linux/
RUN --network=none test ! -e /usr/bin/swiftc && test -f /usr/lib/swift/linux/libswiftCore.so

FROM swift-sdk AS swift-compiler
USER root
WORKDIR /opt
COPY --from=judge /opt/mount.yaml /opt/
COPY --from=judge-build /out/go-judge /opt/go-judge
COPY --from=go-runtime /usr/local/go /usr/local/go
COPY --from=go-test-tools /out/ /usr/local/bin/
RUN set -eux; \
	apt-get update; \
	apt-get install -y --no-install-recommends curl; \
	rm -rf /var/lib/apt/lists/*
RUN --network=none /usr/bin/swiftc --version | grep -F 'Swift version 6.4.3' && \
	test "$(GOTOOLCHAIN=local /usr/local/go/bin/go env GOVERSION)" = "go1.26.11"
ENTRYPOINT ["/opt/go-judge"]
CMD []

FROM runtime AS runner
