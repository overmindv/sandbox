ARG GOJUDGE_IMAGE=criyle/go-judge:latest
ARG GO_RUNTIME_VERSION=1.26

FROM golang:${GO_RUNTIME_VERSION}-alpine AS go-runtime
FROM go-runtime AS go-test-tools

WORKDIR /src
COPY go.mod ./
COPY cmd/sandbox-go-test-compile/ ./cmd/sandbox-go-test-compile/
COPY internal/gotestjob/ ./internal/gotestjob/
ENV CGO_ENABLED=0 GOTOOLCHAIN=local GOENV=off
RUN --network=none go build -trimpath -ldflags='-s -w' -o /out/sandbox-go-test-compile ./cmd/sandbox-go-test-compile && \
	go build -trimpath -ldflags='-s -w' -o /out/sandbox-go-test2json cmd/test2json

FROM ${GOJUDGE_IMAGE}

ARG GO_RUNTIME_VERSION=1.26

USER root

COPY --from=go-runtime /usr/local/go /usr/local/go
COPY --from=go-test-tools /out/ /usr/local/bin/

RUN set -eux; \
	if command -v apt-get >/dev/null 2>&1; then \
		apt-get update; \
		apt-get install -y --no-install-recommends ca-certificates curl python3 python3-pytest; \
		rm -rf /var/lib/apt/lists/*; \
	elif command -v apk >/dev/null 2>&1; then \
		apk add --no-cache ca-certificates curl python3 py3-pytest; \
	elif command -v microdnf >/dev/null 2>&1; then \
		microdnf install -y ca-certificates curl python3 python3-pytest; \
		microdnf clean all; \
	else \
		echo "unsupported go-judge base image: no apt-get, apk, or microdnf" >&2; \
		exit 1; \
	fi; \
	python3 -m pytest --version; \
	/usr/local/go/bin/go version

ENV PATH="/usr/local/go/bin:${PATH}" \
	CGO_ENABLED=0 \
	GOCACHE=/tmp/go-build \
	GOMODCACHE=/tmp/go-mod \
	GOTOOLCHAIN=local \
	GOPROXY=off
