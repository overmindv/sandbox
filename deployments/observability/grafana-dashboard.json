{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "links": [],
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "targets": [
        {
          "expr": "sum by (topic) (rate(sandbox_kafka_messages_consumed_total[5m]))",
          "legendFormat": "consumed {{topic}}",
          "refId": "A"
        },
        {
          "expr": "sum by (topic) (rate(sandbox_kafka_messages_produced_total[5m]))",
          "legendFormat": "produced {{topic}}",
          "refId": "B"
        }
      ],
      "title": "Kafka Throughput",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "id": 2,
      "targets": [
        {
          "expr": "max by (topic) (sandbox_kafka_queue_lag_ms_max)",
          "legendFormat": "{{topic}}",
          "refId": "A"
        }
      ],
      "title": "Kafka Queue Lag",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "id": 3,
      "targets": [
        {
          "expr": "sum by (language) (rate(sandbox_executor_latency_ms_sum[5m])) / clamp_min(sum by (language) (rate(sandbox_executor_latency_ms_count[5m])), 0.001)",
          "legendFormat": "{{language}}",
          "refId": "A"
        }
      ],
      "title": "Executor Latency Avg",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 8
      },
      "id": 4,
      "targets": [
        {
          "expr": "sum by (status) (rate(sandbox_results_total[5m]))",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ],
      "title": "Results By Status",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 8
      },
      "id": 5,
      "targets": [
        {
          "expr": "sandbox_scheduler_in_flight",
          "legendFormat": "global",
          "refId": "A"
        },
        {
          "expr": "sandbox_scheduler_queue_depth",
          "legendFormat": "queue",
          "refId": "B"
        }
      ],
      "title": "Scheduler Pressure",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 8
      },
      "id": 6,
      "targets": [
        {
          "expr": "sum by (reason) (increase(sandbox_kafka_dlq_published_total[15m]))",
          "legendFormat": "DLQ {{reason}}",
          "refId": "A"
        },
        {
          "expr": "sum by (reason) (increase(sandbox_kafka_message_failures_total[15m]))",
          "legendFormat": "failed {{reason}}",
          "refId": "B"
        }
      ],
      "title": "Failures And DLQ",
      "type": "timeseries"
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": [
    "sandbox",
    "worker"
  ],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "browser",
