{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://overmindv.local/schemas/sandbox.run.event.v1.json",
  "title": "Sandbox Run Event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "submission_id",
    "attempt_id",
    "event_type",
    "status",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "sandbox.run.event.v1"
    },
    "submission_id": {
      "type": "string",
      "format": "uuid"
    },
    "attempt_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "accepted",
        "queued",
        "started",
        "prepared",
        "completed",
        "failed",
        "rejected",
        "retried"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "passed",
        "failed",
        "compile_error",
        "runtime_error",
        "tle",
        "mle",
        "ole",
        "internal_error",
        "invalid_request",
        "unsupported_language"
      ]
    },
    "message": {
      "type": "string",
      "maxLength": 1024
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "queue_ms": {
          "type": "integer",
          "minimum": 0
        },
        "elapsed_ms": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "trace_id": {
      "type": "string",
      "maxLength": 128
    },
    "worker_id": {
      "type": "string",
      "maxLength": 128
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "examples": [
    {
      "schema_version": "sandbox.run.event.v1",
      "submission_id": "11111111-1111-4111-8111-111111111111",
      "attempt_id": "22222222-2222-4222-8222-222222222222",
      "event_type": "started",
      "status": "running",
      "message": "Execution started",
      "timing": {
        "queue_ms": 12,
        "elapsed_ms": 0
      },
      "trace_id": "trace-111",
      "worker_id": "sandbox-worker-1",
      "created_at": "2026-08-12T19:00:00Z"
    }
  ]
}
