{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://overmindv.local/schemas/sandbox.run.result.v1.json",
  "title": "Sandbox Run Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "submission_id",
    "attempt_id",
    "status",
    "summary",
    "timing",
    "resources",
    "logs",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "sandbox.run.result.v1"
    },
    "submission_id": {
      "type": "string",
      "format": "uuid"
    },
    "attempt_id": {
      "type": "string",
      "format": "uuid"
    },
    "user_id": {
      "type": "string",
      "format": "uuid"
    },
    "task_id": {
      "type": "string",
      "format": "uuid"
    },
    "language": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "status": {
      "$ref": "#/$defs/status"
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tests_total", "tests_passed", "tests_failed"],
      "properties": {
        "tests_total": {
          "type": "integer",
          "minimum": 0
        },
        "tests_passed": {
          "type": "integer",
          "minimum": 0
        },
        "tests_failed": {
          "type": "integer",
          "minimum": 0
        },
        "first_failed_test": {
          "type": "string",
          "maxLength": 256
        }
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["queue_ms", "prepare_ms", "run_ms", "total_ms"],
      "properties": {
        "queue_ms": {
          "type": "integer",
          "minimum": 0
        },
        "prepare_ms": {
          "type": "integer",
          "minimum": 0
        },
        "run_ms": {
          "type": "integer",
          "minimum": 0
        },
        "total_ms": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu_ms", "memory_peak_bytes"],
      "properties": {
        "cpu_ms": {
          "type": "integer",
          "minimum": 0
        },
        "memory_peak_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "exit_code": {
          "type": ["integer", "null"]
        },
        "signal": {
          "type": ["string", "null"],
          "maxLength": 64
        }
      }
    },
    "logs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stdout", "stderr", "truncated"],
      "properties": {
        "stdout": {
          "type": "string",
          "maxLength": 1048576
        },
        "stderr": {
          "type": "string",
          "maxLength": 1048576
        },
        "truncated": {
          "type": "boolean"
        }
      }
    },
    "tests": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "status": {
            "type": "string",
            "enum": ["passed", "failed", "skipped", "error"]
          },
          "duration_ms": {
            "type": "integer",
            "minimum": 0
          },
          "message": {
            "type": "string",
            "maxLength": 4096
          }
        }
      }
    },
    "error": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "retryable": {
          "type": "boolean"
        },
        "details": {
          "type": "object",
          "additionalProperties": {
            "type": ["string", "number", "boolean", "null"]
          },
          "maxProperties": 32
        }
      }
    },
    "trace_id": {
      "type": "string",
      "maxLength": 128
    },
    "worker_id": {
      "type": "string",
      "maxLength": 128
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "status": {
      "type": "string",
      "enum": [
        "passed",
        "failed",
        "compile_error",
        "runtime_error",
        "tle",
        "mle",
        "ole",
        "internal_error",
        "invalid_request",
        "unsupported_language"
      ]
    }
  },
  "examples": [
    {
      "schema_version": "sandbox.run.result.v1",
      "submission_id": "11111111-1111-4111-8111-111111111111",
      "attempt_id": "22222222-2222-4222-8222-222222222222",
      "user_id": "33333333-3333-4333-8333-333333333333",
      "task_id": "44444444-4444-4444-8444-444444444444",
      "language": {
        "id": "python",
        "version": "3.12"
      },
      "status": "passed",
      "summary": {
        "tests_total": 1,
        "tests_passed": 1,
        "tests_failed": 0
      },
      "timing": {
        "queue_ms": 12,
        "prepare_ms": 8,
        "run_ms": 431,
        "total_ms": 451
      },
      "resources": {
        "cpu_ms": 390,
        "memory_peak_bytes": 45088768,
        "exit_code": 0,
        "signal": null
      },
      "logs": {
        "stdout": ".\\n1 passed in 0.02s\\n",
        "stderr": "",
        "truncated": false
      },
      "tests": [
        {
          "name": "test_solution.py::test_add",
          "status": "passed",
          "duration_ms": 2
        }
      ],
      "error": null,
      "trace_id": "trace-111",
      "worker_id": "sandbox-worker-1",
      "created_at": "2026-08-12T19:00:01Z"
    }
  ]
}
