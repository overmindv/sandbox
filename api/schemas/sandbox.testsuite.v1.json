{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://overmindv.local/schemas/sandbox.testsuite.v1.json",
  "title": "Sandbox Test Suite v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "suite_id", "mode", "files"],
  "properties": {
    "schema_version": {
      "const": "sandbox.testsuite.v1"
    },
    "suite_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "mode": {
      "type": "string",
      "enum": ["pytest", "go-test"]
    },
    "entrypoint": {
      "type": "string",
      "maxLength": 256
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "content_b64"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "content_b64": {
            "type": "string",
            "minLength": 1
          },
          "checksum_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": {
        "type": ["string", "number", "boolean", "null"]
      },
      "maxProperties": 32
    }
  },
  "examples": [
    {
      "schema_version": "sandbox.testsuite.v1",
      "suite_id": "python-addition",
      "version": "v1",
      "mode": "pytest",
      "entrypoint": "test_solution.py",
      "files": [
        {
          "path": "test_solution.py",
          "content_b64": "ZnJvbSBzb2x1dGlvbiBpbXBvcnQgYWRkCgpkZWYgdGVzdF9hZGQoKToKICAgIGFzc2VydCBhZGQoMSwgMikgPT0gMwo="
        }
      ]
    }
  ]
}
