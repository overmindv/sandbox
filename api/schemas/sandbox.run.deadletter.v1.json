{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://overmindv.local/schemas/sandbox.run.deadletter.v1.json",
  "title": "Sandbox Run Dead Letter v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "reason",
    "retryable",
    "failed_at",
    "original_topic",
    "original_partition",
    "original_offset"
  ],
  "properties": {
    "schema_version": {
      "const": "sandbox.run.deadletter.v1"
    },
    "submission_id": {
      "type": "string",
      "format": "uuid"
    },
    "attempt_id": {
      "type": "string",
      "format": "uuid"
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "message": {
      "type": "string",
      "maxLength": 4096
    },
    "retryable": {
      "type": "boolean"
    },
    "retry_count": {
      "type": "integer",
      "minimum": 0,
      "default": 0
    },
    "original_topic": {
      "type": "string",
      "minLength": 1,
      "maxLength": 249
    },
    "original_partition": {
      "type": "integer",
      "minimum": 0
    },
    "original_offset": {
      "type": "integer",
      "minimum": 0
    },
    "original_key": {
      "type": ["string", "null"],
      "maxLength": 512
    },
    "original_payload_b64": {
      "type": ["string", "null"],
      "contentEncoding": "base64"
    },
    "trace_id": {
      "type": "string",
      "maxLength": 128
    },
    "worker_id": {
      "type": "string",
      "maxLength": 128
    },
    "failed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "examples": [
    {
      "schema_version": "sandbox.run.deadletter.v1",
      "submission_id": "11111111-1111-4111-8111-111111111111",
      "attempt_id": "22222222-2222-4222-8222-222222222222",
      "reason": "invalid_request",
      "message": "Missing required field: language",
      "retryable": false,
      "retry_count": 0,
      "original_topic": "code-execution.requests.v1",
      "original_partition": 0,
      "original_offset": 42,
      "original_key": "11111111-1111-4111-8111-111111111111",
      "original_payload_b64": null,
      "trace_id": "trace-111",
      "worker_id": "sandbox-worker-1",
      "failed_at": "2026-08-12T19:00:00Z"
    }
  ]
}
